{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Prep Pal AI — Overview",
  "uid": "preppal-overview",
  "version": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Ollama up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        }
      },
      "targets": [ { "expr": "preppal_ollama_up", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "KB chunks indexed",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "expr": "preppal_kb_chunks", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Requests / sec (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "expr": "sum(rate(http_requests_total[5m]))", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "LLM errors / sec (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "expr": "sum(rate(preppal_llm_requests_total{status=\"error\"}[5m]))", "refId": "A" } ]
    },
    {
      "type": "timeseries",
      "title": "LLM request latency p95 by surface",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(preppal_llm_request_duration_seconds_bucket[5m])) by (le, surface))",
          "legendFormat": "{{surface}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Streamed tokens / sec by surface",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(preppal_stream_tokens_total[1m])) by (surface)",
          "legendFormat": "{{surface}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate by handler",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM requests by surface & status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(preppal_llm_requests_total[5m])) by (surface, status)",
          "legendFormat": "{{surface}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Web logs (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [ { "expr": "{compose_service=\"web\"}", "refId": "A" } ]
    }
  ]
}
